      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co ci chodzi po głowie?"
          }
        }
      }
    },
    "When on, MOMENT can adjust suggestions using how your past decisions turned out. Learning stays on this device.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy włączone, MOMENT może dostosowywać sugestie do tego, jak wyszły twoje wcześniejsze decyzje. Nauka odbywa się tylko na tym urządzeniu."
          }
        }
      }
    },
    "Who is this about?": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kogo to dotyczy?"
          }
        }
      }
    },
    "Why these fit": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego te pasują"
          }
        }
      }
    },
    "Work": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praca"
          }
        }
      }
    },
    "Write the reply in Reply Studio": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz odpowiedź w Studiu odpowiedzi"
          }
        }
      }
    },
    "You chose": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój wybór"
          }
        }
      }
    },
    "You most often come to MOMENT feeling %@.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najczęściej wracasz do MOMENT z uczuciem: %@."
          }
        }
      }
    },
