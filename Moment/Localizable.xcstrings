    "Your saved decisions stay in History. They just won't be linked to this person.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zapisane decyzje zostają w Historii. Po prostu nie będą powiązane z tą osobą."
          }
        }
      }
    },
    "Your saved moments are varied. No clear pattern stands out yet.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zapisane momenty są różnorodne. Żaden wyraźny wzorzec jeszcze się nie rysuje."
          }
        }
      }
    },
